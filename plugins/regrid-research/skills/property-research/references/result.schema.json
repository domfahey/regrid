{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regrid research handoff and checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "results",
    "budget",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "reconciliations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reconciliation"
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_records",
        "attempted_requests",
        "returned_records",
        "uncertain_records"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_records": {
          "type": "integer",
          "minimum": 0
        },
        "attempted_requests": {
          "type": "integer",
          "minimum": 0
        },
        "returned_records": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "retrieved_at",
        "source_refreshed_at",
        "source_url",
        "evidence_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "source_refreshed_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parcel_id",
        "address",
        "facts",
        "provenance"
      ],
      "properties": {
        "parcel_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "facts": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "message",
        "outcome_uncertain"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome_uncertain": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "requested",
        "lookup_status",
        "match_status",
        "candidates",
        "missing_fields",
        "error",
        "notes"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requested": {
          "$ref": "#/$defs/requested"
        },
        "lookup_status": {
          "enum": [
            "success",
            "error",
            "not_attempted"
          ]
        },
        "match_status": {
          "enum": [
            "confirmed",
            "ambiguous",
            "unmatched",
            "not_assessed"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lookup_status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "match_status": {
                "enum": [
                  "confirmed",
                  "ambiguous",
                  "unmatched"
                ]
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lookup_status": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "match_status": {
                "const": "not_assessed"
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lookup_status": {
                "const": "not_attempted"
              }
            }
          },
          "then": {
            "properties": {
              "match_status": {
                "const": "not_assessed"
              },
              "error": {
                "type": "null"
              },
              "candidates": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match_status": {
                "enum": [
                  "confirmed",
                  "ambiguous"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "input_ids",
        "state",
        "record_limit",
        "returned_records"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "pending",
            "success",
            "error",
            "uncertain"
          ]
        },
        "record_limit": {
          "type": "integer",
          "minimum": 0
        },
        "returned_records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "kind": {
          "enum": [
            "lookup",
            "diagnostic"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "uncertain"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "returned_records": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "returned_records": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "diagnostic"
              }
            }
          },
          "then": {
            "properties": {
              "input_ids": {
                "maxItems": 0
              },
              "record_limit": {
                "const": 0
              },
              "returned_records": {
                "enum": [
                  null,
                  0
                ]
              }
            }
          },
          "else": {
            "properties": {
              "input_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "legacy_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "parcel_id",
        "scope"
      ],
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "parcel_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "anyOf": [
        {
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "properties": {
            "parcel_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "owner_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_type",
        "owner",
        "scope"
      ],
      "properties": {
        "query_type": {
          "const": "owner"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "point_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_type",
        "lat",
        "lon",
        "radius"
      ],
      "properties": {
        "query_type": {
          "const": "point"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "area_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_type",
        "bbox"
      ],
      "properties": {
        "query_type": {
          "const": "area"
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ]
        }
      }
    },
    "filter_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_type",
        "scope",
        "filters"
      ],
      "properties": {
        "query_type": {
          "const": "filter"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "filters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "requested": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacy_requested"
        },
        {
          "$ref": "#/$defs/owner_query"
        },
        {
          "$ref": "#/$defs/point_query"
        },
        {
          "$ref": "#/$defs/area_query"
        },
        {
          "$ref": "#/$defs/filter_query"
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "evidence_id",
        "retrieved_at",
        "attempt_id",
        "returned_records",
        "source_url"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "returned_records": {
          "type": "integer",
          "minimum": 0
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "proof"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "proof": {
          "$ref": "#/$defs/receipt"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "reconciliations"
        ],
        "properties": {
          "attempts": {
            "items": {
              "required": [
                "kind"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "reconciliations": false,
          "results": {
            "items": {
              "properties": {
                "requested": {
                  "$ref": "#/$defs/legacy_requested"
                }
              }
            }
          },
          "attempts": {
            "items": {
              "properties": {
                "kind": false
              }
            }
          }
        }
      }
    }
  ],
  "description": "Versions 1.0 and 1.1. Runtime validation additionally enforces cross-field invariants: unique IDs, ordered bounding boxes, matching attempt references, immutable observation consistency, receipt uniqueness, and exact ledger-derived counters. Receipts require caller verification of authoritative per-attempt evidence; this schema does not authenticate providers."
}
