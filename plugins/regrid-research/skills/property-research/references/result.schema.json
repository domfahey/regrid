{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regrid research handoff and checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "results",
    "budget",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_records",
        "attempted_requests",
        "returned_records",
        "uncertain_records"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_records": {
          "type": "integer",
          "minimum": 0
        },
        "attempted_requests": {
          "type": "integer",
          "minimum": 0
        },
        "returned_records": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "parcel_id",
        "scope"
      ],
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "parcel_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "anyOf": [
        {
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "properties": {
            "parcel_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "retrieved_at",
        "source_refreshed_at",
        "source_url",
        "evidence_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "source_refreshed_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parcel_id",
        "address",
        "facts",
        "provenance"
      ],
      "properties": {
        "parcel_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "facts": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "message",
        "outcome_uncertain"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome_uncertain": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "requested",
        "lookup_status",
        "match_status",
        "candidates",
        "missing_fields",
        "error",
        "notes"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requested": {
          "$ref": "#/$defs/requested"
        },
        "lookup_status": {
          "enum": [
            "success",
            "error",
            "not_attempted"
          ]
        },
        "match_status": {
          "enum": [
            "confirmed",
            "ambiguous",
            "unmatched",
            "not_assessed"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lookup_status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "match_status": {
                "enum": [
                  "confirmed",
                  "ambiguous",
                  "unmatched"
                ]
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lookup_status": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "match_status": {
                "const": "not_assessed"
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lookup_status": {
                "const": "not_attempted"
              }
            }
          },
          "then": {
            "properties": {
              "match_status": {
                "const": "not_assessed"
              },
              "error": {
                "type": "null"
              },
              "candidates": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match_status": {
                "enum": [
                  "confirmed",
                  "ambiguous"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "input_ids",
        "state",
        "record_limit",
        "returned_records"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "pending",
            "success",
            "error",
            "uncertain"
          ]
        },
        "record_limit": {
          "type": "integer",
          "minimum": 0
        },
        "returned_records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "uncertain"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "returned_records": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "returned_records": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
